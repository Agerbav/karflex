<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="18dp"
    android:padding="10dp">

    <ImageView
        android:id="@+id/vehicleIV"
        android:layout_width="80dp"
        android:layout_height="80dp"/>

    <TextView
        android:id="@+id/modelNameTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/vehicleIV"
        android:layout_toRightOf="@id/vehicleIV"
        android:text="Model Name"
        android:textStyle="bold"
        android:textSize="18dp"
        android:paddingLeft="18dp"/>

    <TextView
        android:id="@+id/brandTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/modelNameTV"
        android:layout_toRightOf="@id/vehicleIV"
        android:layout_toEndOf="@id/vehicleIV"
        android:text="Brand"
        android:paddingLeft="18dp"/>

    <TextView
        android:id="@+id/transmissionTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/brandTV"
        android:layout_toRightOf="@id/vehicleIV"
        android:layout_toEndOf="@id/vehicleIV"
        android:text="Transmission"
        android:paddingLeft="18dp"/>

    <TextView
        android:id="@+id/priceTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/transmissionTV"
        android:layout_toEndOf="@id/vehicleIV"
        android:layout_toRightOf="@id/vehicleIV"
        android:text="Price"
        android:textStyle="italic"
        android:textSize="10dp"
        android:paddingLeft="18dp"/>

</RelativeLayout>